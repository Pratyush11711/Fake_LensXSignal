# =====================================================================
# FakeLens + SIGNAL Configuration Options (.env.example)
# Sane defaults are provided across both NLP and Deepfake pipelines.
# =====================================================================

# Server Port
PORT=5000

# --- SIGNAL Deepfake Detector Configuration ---
# Active deepfake model backend: "baseline", "lipforensics", or "temporal_xception"
MODEL_BACKEND=baseline

# Pretrained HuggingFace model for Vision Transformer frame-level classification
MODEL_NAME=dima806/deepfake_vs_real_image_detection

# Face detector model (OpenCV YuNet ONNX)
FACE_DETECTOR_MODEL=models/face_detection_yunet_2023mar.onnx

# Checkpoint paths for advanced models (optional)
LIPFORENSICS_CHECKPOINT=models/weights/lipforensics_ff.pth
TEMPORAL_MODEL_WEIGHTS=models/best_temporal_model.pth

# Sampling & Thresholds
FRAMES_TO_CHECK=16
MAX_UPLOAD_MB=100
MAX_VIDEO_SECONDS=300
INFERENCE_CONCURRENCY=2

# Bounding box & Detection Parameters
FACE_CROP_MARGIN=0.25
FACE_SCORE_THRESHOLD=0.6
FACE_NMS_THRESHOLD=0.3
MIN_FACE_SIZE=40

# Logging
LOG_LEVEL=INFO
ALLOWED_ORIGINS=*
